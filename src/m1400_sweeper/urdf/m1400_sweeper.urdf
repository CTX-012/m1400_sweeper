<?xml version="1.0"?>
<robot name="m1400_sweeper">

  <material name="body_teal"><color rgba="0.10 0.48 0.55 1"/></material>
  <material name="body_dark"><color rgba="0.06 0.32 0.38 1"/></material>
  <material name="chassis_grey"><color rgba="0.48 0.49 0.51 1"/></material>
  <material name="rubber"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="brush_base"><color rgba="0.25 0.25 0.23 1"/></material>
  <material name="brush_bristles"><color rgba="0.82 0.80 0.72 1"/></material>
  <material name="lidar_black"><color rgba="0.10 0.10 0.10 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1524" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.05 0 0.40" rpy="0 0 0"/>
      <mass value="250.0"/>
      <inertia ixx="35.0" ixy="0.0" ixz="0.0" iyy="40.0" iyz="0.0" izz="45.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.04 0 0.48"/>
      <geometry><box size="1.30 1.04 0.36"/></geometry>
      <material name="body_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.04 0 0.76"/>
      <geometry><box size="1.16 0.92 0.24"/></geometry>
      <material name="body_teal"/>
    </visual>
    <visual>
      <origin xyz="-0.06 0 0.91"/>
      <geometry><box size="0.98 0.78 0.10"/></geometry>
      <material name="body_teal"/>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0.62"/>
      <geometry><box size="1.10 0.82 0.68"/></geometry>
    </collision>
  </link>

  <link name="lower_chassis">
    <inertial>
      <mass value="35"/>
      <inertia ixx="3.0" ixy="0.0" ixz="0.0" iyy="4.0" iyz="0.0" izz="5.0"/>
    </inertial>
    <visual>
      <geometry><box size="1.48 1.16 0.16"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <geometry><box size="1.42 1.08 0.14"/></geometry>
    </collision>
  </link>

  <joint name="lower_chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lower_chassis"/>
    <origin xyz="-0.02 0 0.25"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="8"/>
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.18" iyz="0.0" izz="0.10"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.36 0.49 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="8"/>
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.18" iyz="0.0" izz="0.10"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.36 -0.49 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="support_wheel">
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.18" iyz="0.0" izz="0.10"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.1524" length="0.08"/></geometry>
    </collision>
  </link>

  <joint name="support_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="support_wheel"/>
    <origin xyz="0.40 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_brush_shaft">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1075"/>
      <geometry><cylinder radius="0.035" length="0.215"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1075"/>
      <geometry><cylinder radius="0.035" length="0.215"/></geometry>
    </collision>
  </link>
  <joint name="left_brush_shaft_joint" type="fixed"><parent link="base_link"/><child link="left_brush_shaft"/><origin xyz="0.54 0.36 0.24"/></joint>

  <link name="right_brush_shaft">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1075"/>
      <geometry><cylinder radius="0.035" length="0.215"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1075"/>
      <geometry><cylinder radius="0.035" length="0.215"/></geometry>
    </collision>
  </link>
  <joint name="right_brush_shaft_joint" type="fixed"><parent link="base_link"/><child link="right_brush_shaft"/><origin xyz="0.54 -0.36 0.24"/></joint>

  <link name="left_brush">
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0125"/>
      <geometry><cylinder radius="0.30" length="0.025"/></geometry>
      <material name="brush_base"/>
    </visual>
    <visual>
      <origin xyz="0.18 0 -0.027"/>
      <geometry><box size="0.22 0.025 0.004"/></geometry>
      <material name="brush_bristles"/>
    </visual>
  </link>
  <joint name="left_brush_joint" type="continuous"><parent link="base_link"/><child link="left_brush"/><origin xyz="0.54 0.36 -0.1274"/><axis xyz="0 0 1"/></joint>

  <link name="right_brush">
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0125"/>
      <geometry><cylinder radius="0.30" length="0.025"/></geometry>
      <material name="brush_base"/>
    </visual>
    <visual>
      <origin xyz="0.18 0 -0.027"/>
      <geometry><box size="0.22 0.025 0.004"/></geometry>
      <material name="brush_bristles"/>
    </visual>
  </link>
  <joint name="right_brush_joint" type="continuous"><parent link="base_link"/><child link="right_brush"/><origin xyz="0.54 -0.36 -0.1274"/><axis xyz="0 0 1"/></joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0003"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="-0.06 0 1.00"/></joint>

  <!-- Gazebo Sensors & Plugins -->
  
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <plugin
        filename="libignition-gazebo-sensors-system.so"
        name="ignition::gazebo::systems::Sensors"/>
    </sensor>
  </gazebo>

  <!-- Front camera
  <link name="front_camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0" ixz="0"
        iyy="0.0001" iyz="0"
        izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.08 0.06"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.58 0 0.78" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>

      <plugin
        filename="libignition-gazebo-sensors-system.so"
        name="ignition::gazebo::systems::Sensors"/>
    </sensor>
  </gazebo> -->

  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.98</wheel_separation>
      <wheel_radius>0.1524</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Gazebo Joint State Publisher Plugin -->
  
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>


  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="support_wheel"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>

</robot>