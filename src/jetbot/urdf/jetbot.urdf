<?xml version="1.0"?>
<robot name="jetbot">

  <!--
    Waveshare JetBot ROS AI Kit - simple URDF (no meshes), Gazebo Fortress (ros_gz).
    Round two-deck chassis, two 65 mm drive wheels, 1-inch casters front + rear,
    RPLIDAR A1 on the top deck, IMX219 camera at the front.
    Key numbers to check against your robot (metres):
      wheel radius 0.0325 | wheel separation 0.20 | deck diameter 0.17
    Measured heights above the floor:
      chassis top 2.5 in (0.0635) | camera top 4.0 in (0.1016) | lidar top 6.5 in (0.1651)
  -->

  <material name="deck_black"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="acrylic"><color rgba="0.85 0.88 0.92 0.55"/></material>
  <material name="motor_gold"><color rgba="0.78 0.62 0.25 1"/></material>
  <material name="rubber"><color rgba="0.06 0.06 0.06 1"/></material>
  <material name="hub_grey"><color rgba="0.60 0.60 0.62 1"/></material>
  <material name="standoff"><color rgba="0.80 0.70 0.30 1"/></material>
  <material name="jetson_green"><color rgba="0.10 0.40 0.18 1"/></material>
  <material name="heatsink"><color rgba="0.18 0.18 0.20 1"/></material>
  <material name="battery_blue"><color rgba="0.15 0.35 0.75 1"/></material>
  <material name="lidar_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="lidar_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="camera_pcb"><color rgba="0.05 0.30 0.10 1"/></material>
  <material name="lens"><color rgba="0.02 0.02 0.02 1"/></material>
  <material name="caster_grey"><color rgba="0.55 0.55 0.58 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.0518"/>
      <mass value="1.55"/>
      <inertia ixx="0.0031436" ixy="0" ixz="0" iyy="0.0031436" iyz="0" izz="0.0055994"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0285" rpy="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.005"/></geometry>
      <material name="deck_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0756" rpy="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.004"/></geometry>
      <material name="acrylic"/>
    </visual>
    <visual>
      <origin xyz="0.055 0.05 0.0520" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="0.0471"/></geometry>
      <material name="standoff"/>
    </visual>
    <visual>
      <origin xyz="0.055 -0.05 0.0520" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="0.0471"/></geometry>
      <material name="standoff"/>
    </visual>
    <visual>
      <origin xyz="-0.055 0.05 0.0520" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="0.0471"/></geometry>
      <material name="standoff"/>
    </visual>
    <visual>
      <origin xyz="-0.055 -0.05 0.0520" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="0.0471"/></geometry>
      <material name="standoff"/>
    </visual>
    <visual>
      <origin xyz="0 0.047 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0185" length="0.075"/></geometry>
      <material name="motor_gold"/>
    </visual>
    <visual>
      <origin xyz="0 0.047 0.0222" rpy="0 0 0"/>
      <geometry><box size="0.03 0.05 0.0075"/></geometry>
      <material name="deck_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.047 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0185" length="0.075"/></geometry>
      <material name="motor_gold"/>
    </visual>
    <visual>
      <origin xyz="0 -0.047 0.0222" rpy="0 0 0"/>
      <geometry><box size="0.03 0.05 0.0075"/></geometry>
      <material name="deck_black"/>
    </visual>
    <visual>
      <origin xyz="-0.0385 0 0.0150" rpy="0 0 0"/>
      <geometry><box size="0.04 0.06 0.022"/></geometry>
      <material name="battery_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.005 0 0.0370" rpy="0 0 0"/>
      <geometry><box size="0.1 0.08 0.012"/></geometry>
      <material name="jetson_green"/>
    </visual>
    <visual>
      <origin xyz="-0.005 0 0.0540" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.022"/></geometry>
      <material name="heatsink"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0518" rpy="0 0 0"/>
      <geometry><cylinder radius="0.085" length="0.0516"/></geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0" ixz="0" iyy="0.0000423" iyz="0" izz="0.0000256"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.016" length="0.028"/></geometry>
      <material name="hub_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0" ixz="0" iyy="0.0000423" iyz="0" izz="0.0000256"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.016" length="0.028"/></geometry>
      <material name="hub_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000013" ixy="0" ixz="0" iyy="0.0000013" iyz="0" izz="0.0000013"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0127"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0288" rpy="0 0 0"/>
      <geometry><box size="0.022 0.022 0.0321"/></geometry>
      <material name="deck_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0127"/></geometry>
    </collision>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.068 0 -0.0188" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000013" ixy="0" ixz="0" iyy="0.0000013" iyz="0" izz="0.0000013"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0127"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0288" rpy="0 0 0"/>
      <geometry><box size="0.022 0.022 0.0321"/></geometry>
      <material name="deck_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0127"/></geometry>
    </collision>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.068 0 -0.0188" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 -0.0125"/>
      <mass value="0.17"/>
      <inertia ixx="0.0000949" ixy="0" ixz="0" iyy="0.0000949" iyz="0" izz="0.0001041"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <visual>
      <origin xyz="-0.010 0 -0.0275" rpy="0 0 0"/>
      <geometry><box size="0.09 0.07 0.03"/></geometry>
      <material name="lidar_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0150" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.055"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.1201" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000021" ixy="0" ixz="0" iyy="0.0000013" iyz="0" izz="0.0000013"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.006 0.025 0.025"/></geometry>
      <material name="camera_pcb"/>
    </visual>
    <visual>
      <origin xyz="0.009 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.007" length="0.012"/></geometry>
      <material name="lens"/>
    </visual>
    <visual>
      <origin xyz="-0.008 0 -0.0199" rpy="0 0 0"/>
      <geometry><box size="0.01 0.02 0.0148"/></geometry>
      <material name="deck_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.025 0.025"/></geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.088 0 0.0563" rpy="0 0.15 0"/>
  </joint>

  <!-- optical frame (z forward, x right, y down) for image consumers -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== Gazebo (Fortress) ===================== -->

  <!-- one Sensors system for the whole robot (lidar + camera) -->
  <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="imx219" type="camera">
      <ignition_frame_id>camera_optical_link</ignition_frame_id>
      <topic>/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>2.0</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.20</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <max_linear_velocity>0.6</max_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="rear_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

</robot>