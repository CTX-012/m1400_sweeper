Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Real LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Camera low obstacles
      Enabled: true
      Topic:
        Value: /camera/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 220; 0
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety zone
      Enabled: true
      Topic:
        Value: /obstacle_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera view
      Enabled: true
      Topic:
        Value: /camera/obstacles/image
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Sim LiDAR
      Enabled: false
      Topic:
        Value: /sim/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 80; 160; 255
      Value: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 40; 40; 44
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 2.2
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0
      Pitch: 0.95
      Yaw: 3.14
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
